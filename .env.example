# Copiar a .env.local y completar con los datos del proyecto de Supabase.
# Supabase > Project Settings > Data API  (y > API Keys para la anon key)
#
# La anon key es pública: viaja al navegador y no es un secreto.
# Lo que protege la base es el RLS de supabase/schema.sql.
# NUNCA poner acá la service_role key.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
